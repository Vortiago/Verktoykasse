{
  "group": "falsifiability",
  "sources": [{"name": "Kent Beck, Test Desiderata", "url": "https://kentbeck.github.io/TestDesiderata/"}],
  "cases": [
    {
      "file": "cases/falsifiability-constant-truth.case.mjs",
      "test": "the build is green",
      "defect": "tautology",
      "canFail": false,
      "mustEscalate": true,
      "mixed": false,
      "note": "The assertion holds for every build, so breaking the code cannot fail it."
    },
    {
      "file": "cases/falsifiability-self-parse.case.mjs",
      "test": "parse is stable",
      "defect": "self-reference",
      "canFail": false,
      "mustEscalate": true,
      "mixed": false,
      "note": "Both sides call the same production function, so the comparison is true by construction."
    },
    {
      "file": "cases/falsifiability-helper-agreement.case.mjs",
      "test": "the two totals match",
      "defect": "self-reference",
      "canFail": false,
      "mustEscalate": true,
      "mixed": false,
      "note": "One helper backs both sides, so any change to it moves both sides together."
    },
    {
      "file": "cases/falsifiability-empty-dispatch.case.mjs",
      "test": "events are dispatched",
      "defect": "passes-with-zero",
      "canFail": false,
      "mustEscalate": true,
      "mixed": false,
      "note": "The check only asks whether the collection is defined, so no dispatch passes."
    },
    {
      "file": "cases/falsifiability-aggregate-exists.case.mjs",
      "test": "the summary is produced",
      "defect": "vacuous",
      "canFail": false,
      "mustEscalate": true,
      "mixed": false,
      "note": "The aggregate exists, but no value inside it is ever read."
    },
    {
      "file": "cases/falsifiability-count-nonnegative.case.mjs",
      "test": "the queue is not negative",
      "defect": "vacuous",
      "canFail": false,
      "mustEscalate": true,
      "mixed": false,
      "note": "A length is never negative, so the bound is always true."
    }
  ]
}
