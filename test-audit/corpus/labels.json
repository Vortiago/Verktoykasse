{
  "//": "Labels for the live calibration corpus. `canFail` is the expected answer to the falsifiable question; `mustEscalate` is a test the audit must never pass silently; `mixed` is a test whose expected outcome is escalation. `file` is relative to this directory.",
  "acceptance": {
    "canFailAgreement": 0.9
  },
  "cases": [
    {
      "file": "cases/tautology-constant.case.mjs",
      "test": "the world is sane",
      "canFail": false,
      "mustEscalate": true,
      "note": "tautology: true === true"
    },
    {
      "file": "cases/tautology-selfreference.case.mjs",
      "test": "reader round trips",
      "canFail": false,
      "mustEscalate": true,
      "note": "tautology: both sides call the same production code"
    },
    {
      "file": "cases/vacuous-zero.case.mjs",
      "test": "imports are folded",
      "canFail": false,
      "mustEscalate": true,
      "note": "vacuous: passes when the feature produces nothing"
    },
    {
      "file": "cases/shape-not-value.case.mjs",
      "test": "planner returns roads",
      "canFail": true,
      "mustEscalate": true,
      "note": "shape-not-value: a shape change can fail it, the content is never checked"
    },
    {
      "file": "cases/name-only.case.mjs",
      "test": "computes the tax",
      "canFail": false,
      "mustEscalate": true,
      "note": "name-only: toBeDefined is true for any defined value"
    },
    {
      "file": "cases/skipped.case.mjs",
      "test": "handles overflow",
      "mustEscalate": true,
      "note": "skipped: the static scan flags it before any call"
    },
    {
      "file": "cases/commented-out.case.mjs",
      "test": "parses config",
      "mustEscalate": true,
      "note": "commented-out assertion beside a tautology"
    },
    {
      "file": "cases/wrong-reason-mock.case.mjs",
      "test": "saves the user",
      "canFail": true,
      "mustEscalate": true,
      "note": "passes for the wrong reason: only the mock call is checked"
    },
    {
      "file": "cases/only-negative.case.mjs",
      "test": "no edge for a comment",
      "canFail": true,
      "mustEscalate": true,
      "note": "no positive/negative pair"
    },
    {
      "file": "cases/flaky.case.mjs",
      "test": "debounce fires once",
      "canFail": true,
      "deterministic": false,
      "note": "a real guard, but timer-bound; reported, not escalated"
    },
    {
      "file": "cases/good-unit-add.case.mjs",
      "test": "add handles negatives",
      "canFail": true,
      "mustEscalate": false,
      "note": "a clean unit guard"
    },
    {
      "file": "cases/good-unit-reverse.case.mjs",
      "test": "reverses a string",
      "canFail": true,
      "mustEscalate": false,
      "note": "a clean unit guard"
    },
    {
      "file": "cases/good-regression.case.mjs",
      "test": "regression #42: a single import resolves",
      "canFail": true,
      "mustEscalate": false,
      "note": "a clean regression guard"
    },
    {
      "file": "cases/good-integration.case.mjs",
      "test": "store round trips a value",
      "canFail": true,
      "mustEscalate": false,
      "note": "a clean integration guard"
    },
    {
      "file": "cases/good-e2e.case.mjs",
      "test": "the server answers health",
      "canFail": true,
      "mustEscalate": false,
      "note": "a clean end-to-end guard"
    },
    {
      "file": "cases/mixed-tautology.case.mjs",
      "test": "the world is sane",
      "mixed": true,
      "mustEscalate": true,
      "note": "half tautology, half weak shape assertion"
    },
    {
      "file": "cases/mixed-shape.case.mjs",
      "test": "builds the graph",
      "mixed": true,
      "mustEscalate": true,
      "note": "two shape assertions"
    },
    {
      "file": "cases/mixed-mock.case.mjs",
      "test": "retries once",
      "mixed": true,
      "mustEscalate": true,
      "note": "interaction assertion with a specific count"
    }
  ]
}
